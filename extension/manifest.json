{
  "manifest_version": 3,
  "minimum_chrome_version": "121",
  "name": "NF Auto Profile",
  "version": "1.0.0",
  "incognito": "not_allowed",
  "description": "Open your chosen Netflix profile and enter its saved PIN on this browser.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.netflix.com/*", "https://netflix.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NF Auto Profile",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*", "https://netflix.com/*"],
      "js": ["storage.js", "netflix.js", "notice.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
